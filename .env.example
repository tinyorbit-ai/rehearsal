# Copy this file to `.env.local` and fill in the values you actually use.
# `.env.local` is gitignored — keys committed to git should be considered
# compromised. Keys here are read ONLY from server routes (`app/api/*`); they
# are never bundled into the client. Do NOT use `NEXT_PUBLIC_` prefixes for
# secrets — those get inlined into the browser bundle.

# Vercel AI Gateway — final LLM analysis. This is the ONLY network call the
# app makes (audio + video stay on-device).
# Either set the gateway key (recommended)…
AI_GATEWAY_API_KEY=

# …or set a direct provider key matching the model string in ANALYSIS_MODEL.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Model string in `provider/model` format. Defaults to openai/gpt-5.5.
# Change this string to switch model. Examples:
#   openai/gpt-5.5
#   anthropic/claude-sonnet-4.6
#   xai/grok-4.1
ANALYSIS_MODEL=openai/gpt-5.5
